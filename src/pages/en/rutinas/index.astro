---
// Espejo de ../../rutinas/index.astro — mismo contenido, solo cambian las
// rutas de import por la carpeta en/ extra. Si cambiás la estructura/JSX en español, replicá el cambio acá.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RoutineManager from '../../../components/react/RoutineManager/RoutineManager';
import { getCollection } from 'astro:content';
import { localizeActivity, localizePlan } from '../../../lib/content-i18n';
import { getDictionary } from '../../../i18n';

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const dict = getDictionary(locale);
const t = dict.rutinas;

const planEntries = await getCollection('plans');
const predefinedRoutines = planEntries
  .map((p) => localizePlan(p, locale, dict))
  .sort((a, b) => a.name.localeCompare(b.name, locale));

const activityEntries = await getCollection('activities');
const activities = activityEntries
  .map((e) => localizeActivity(e, locale, dict))
  .map(({ id, name, discipline, metricType, group, groupLabel, description }) => ({
    id,
    name,
    discipline,
    metricType,
    group,
    groupLabel,
    description,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, locale));
---
<BaseLayout title={t.pageTitle}>
  <p class="label-brutal mb-3 text-acid">{t.kicker}</p>
  <h1 class="mb-8 font-display text-5xl text-paper sm:text-6xl">{t.heading}</h1>
  <RoutineManager client:load predefinedRoutines={predefinedRoutines} activities={activities} t={t} pickerT={dict.registrar.picker} disciplinesT={dict.disciplines} />
</BaseLayout>
