---
// Espejo de ../restablecer-contrasena.astro — mismo contenido, solo cambian
// las rutas de import por la carpeta en/ extra. Si cambiás la estructura/JSX en español, replicá el cambio acá.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResetPasswordForm from '../../components/react/Auth/ResetPasswordForm';
import { getDictionary } from '../../i18n';

const locale = Astro.currentLocale === 'en' ? 'en' : 'es';
const t = getDictionary(locale).auth.resetPassword;
---
<BaseLayout title={t.pageTitle}>
  <p class="label-brutal mb-3 text-acid">{t.kicker}</p>
  <h1 class="mb-8 font-display text-5xl text-paper sm:text-6xl">{t.heading}</h1>
  <ResetPasswordForm client:load t={t} />
</BaseLayout>
