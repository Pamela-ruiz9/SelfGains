---
import BaseLayout from '../layouts/BaseLayout.astro';
import ForgotPasswordForm from '../components/react/Auth/ForgotPasswordForm';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Recuperar contraseña">
  <p class="label-brutal mb-3 text-acid">¿Olvidaste tu clave?</p>
  <h1 class="mb-8 font-display text-5xl text-paper sm:text-6xl">RECUPERAR CONTRASEÑA</h1>
  <ForgotPasswordForm client:load />
  <p class="mt-6 font-mono text-sm text-paper-dim">
    <a href={`${base}login/`} class="text-acid underline underline-offset-4 hover:text-paper">
      Volver a iniciar sesión
    </a>
  </p>
</BaseLayout>
