---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const links = [
  { id: "ejercicios", href: `${base}ejercicios/`, label: "Ejercicios" },
  { id: "rutinas", href: `${base}rutinas/`, label: "Rutinas" },
  { id: "registrar", href: `${base}registro/nuevo/`, label: "Registrar" },
  { id: "progreso", href: `${base}progreso/`, label: "Progreso" },
  { id: "perfil", href: `${base}perfil/`, label: "Perfil" },
];

function isActive(href: string) {
  return path === href || (href !== base && path.startsWith(href));
}

// Hand-rolled outline icons (no icon-library dependency) — currentColor so
// they follow the same text-color classes as the label next to them, which
// keeps them correct across the light/dark/custom-accent theming already in
// place elsewhere in the app.
const ICONS: Record<string, string> = {
  ejercicios: `<path d="M6.5 6.5v11M17.5 6.5v11M4 9v6M20 9v6M8 12h8"/>`,
  rutinas: `<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>`,
  registrar: `<path d="M12 5v14M5 12h14"/>`,
  progreso: `<path d="M5 20V10M12 20V4M19 20v-7"/>`,
  perfil: `<circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/>`,
};

function iconSvg(id: string, strokeWidth = 2) {
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round">${ICONS[id]}</svg>`;
}
---
<header class="sticky top-0 z-50 border-b-2 border-paper bg-ink/95 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
    <a href={base} class="group flex items-baseline gap-1">
      <span class="font-display text-3xl tracking-wide text-paper">SELF</span>
      <span class="font-display text-3xl tracking-wide text-acid">GAINS</span>
    </a>
    <div class="hidden items-center gap-2 font-mono text-sm uppercase tracking-[0.15em] sm:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "flex items-center gap-2 border-2 px-3 py-2 transition-colors duration-150",
              isActive(link.href)
                ? "border-acid bg-acid text-on-accent"
                : "border-transparent text-paper hover:border-paper-dim/50 hover:text-acid",
            ]}
          >
            <span
              class:list={["h-4 w-4 shrink-0", link.id === "perfil" && "overflow-hidden rounded-full"]}
              data-nav-avatar={link.id === "perfil" ? "true" : undefined}
              set:html={iconSvg(link.id)}
            />
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<nav
  class="fixed inset-x-0 bottom-0 z-50 border-t-2 border-paper bg-ink/95 backdrop-blur sm:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="grid grid-cols-5 items-end font-mono text-[10px] uppercase tracking-wide">
    {
      links.map((link, i) =>
        i === 2 ? (
          <a href={link.href} class="relative flex flex-col items-center gap-1 pb-1.5">
            <span
              class:list={[
                "-mt-7 flex h-14 w-14 items-center justify-center rounded-full border-2 transition-colors duration-150",
                isActive(link.href) ? "border-acid bg-acid text-on-accent" : "border-acid bg-ink text-acid",
              ]}
            >
              <span class="h-7 w-7" set:html={iconSvg("registrar", 2.5)} />
            </span>
            <span class:list={["leading-tight", isActive(link.href) ? "text-acid" : "text-paper-dim"]}>
              {link.label}
            </span>
          </a>
        ) : (
          <a
            href={link.href}
            class:list={[
              "flex flex-col items-center justify-center gap-1 border-t-2 py-2.5 text-center leading-tight transition-colors duration-150",
              isActive(link.href) ? "border-acid text-acid" : "border-transparent text-paper-dim",
            ]}
          >
            <span
              class:list={["h-5 w-5 shrink-0", link.id === "perfil" && "overflow-hidden rounded-full"]}
              data-nav-avatar={link.id === "perfil" ? "true" : undefined}
              set:html={iconSvg(link.id)}
            />
            {link.label}
          </a>
        )
      )
    }
  </div>
</nav>

<script>
  import { supabase } from "../../lib/supabase";
  import { getMyProfile } from "../../lib/profile";

  supabase.auth.getSession().then(async ({ data }) => {
    if (!data.session) return;
    try {
      const profile = await getMyProfile();
      if (!profile?.avatar_url) return;
      document.querySelectorAll<HTMLElement>("[data-nav-avatar]").forEach((el) => {
        el.innerHTML = "";
        const img = document.createElement("img");
        img.src = profile.avatar_url as string;
        img.alt = "";
        img.className = "h-full w-full object-cover";
        el.appendChild(img);
      });
    } catch {
      // A failed profile fetch shouldn't break navigation — the fallback
      // person icon just stays put.
    }
  });
</script>
